generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  ORDER_PLACED
  ALLOCATED
  IN_PROVISIONING
  DOCKET_REQUESTED
  DOCKET_ASSIGNED
  DC_REQUESTED
  DC_GENERATED
  PACKED_AND_LABELLED
  EWAY_BILL_REQUESTED
  EWAY_BILL_GENERATED
  DISPATCHED
  DELIVERED
  RTO
  RTO_DC_REQUESTED
  RTO_DC_GENERATED
  RTO_EWAY_BILL_REQUESTED
  RTO_EWAY_BILL_GENERATED
  RTO_IN_TRANSIT
  RTO_DELIVERED_TO_WAREHOUSE
  DELIVERY_CONFIRMED
  INVOICED
  WARRANTY_UPDATED
  CANCELLED
}

enum InventoryStatus {
  NEW
  AVAILABLE
  QC_PENDING
  ALLOCATED
  DEFECTIVE
  RETIRED
}

enum ReversePickupStatus {
  REQUESTED
  PARTNER_ASSIGNED
  DOCKET_REQUESTED
  INSPECTED
  PICKED_UP
  PICKUP_CANCELLED
  DUPLICATE
  ALREADY_SUBMITTED_TO_PWC_OFFICE
  PENDING
  PWC_CONFIRMATION_AWAITED
  GATEPASS_PENDING
  ALIGN_FOR_PICKUP
  IN_TRANSIT
  ON_HOLD
  RTO_CASE
  LOST_DEVICE
  RECEIVED_AT_WAREHOUSE
  QC_CLEANED
  QC_COMPLETED
  DC_REQUESTED
  DC_GENERATED
  EWAY_BILL_REQUESTED
  EWAY_BILL_GENERATED
  BLANCO_CERTIFIED
  COMPLETED
}

enum UserRole {
  ADMIN
  WAREHOUSE
  PROVISIONING
  FINANCE
  LOGISTICS
  WARRANTY
  REVERSE_PICKUP
  PWC
}

model User {
  id                String         @id @default(uuid()) @db.Uuid
  email             String         @unique
  passwordHash      String         @map("password_hash")
  role              UserRole       @default(WAREHOUSE)
  name              String?
  permissions       Json?
  isActive          Boolean        @default(true) @map("is_active")
  twoFactorEnabled  Boolean        @default(false) @map("two_factor_enabled")
  twoFactorSecret   String?        @map("two_factor_secret")
  twoFactorLastStep BigInt?        @map("two_factor_last_step")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  sessions       Session[]
  recoveryCodes  TwoFactorRecoveryCode[]

  @@map("users")
}

model TwoFactorRecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("two_factor_recovery_codes")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique // Hashed session token
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Order {
  id                   String      @id @default(uuid()) @db.Uuid
  clientName           String      @default("PWC") @map("client_name")
  intermediary         String      @default("HP")
  totalQuantity        Int         @map("total_quantity")
  deliveryLocation     String      @map("delivery_location")
  status               OrderStatus @default(ORDER_PLACED)
  warehouseLocation    String?     @map("warehouse_location")
  provisioningLocation String?     @map("provisioning_location")
  engineerName         String?     @map("engineer_name")
  dcNumber             String?     @map("dc_number")
  invoiceNumber        String?     @map("invoice_number")
  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime    @updatedAt @map("updated_at")

  assets               Asset[]
  dockets              Docket[]
  deliveryChallans     DeliveryChallan[]
  rtoRecords           RtoRecord[]

  @@map("orders")
}

model RtoRecord {
  id              String    @id @default(uuid()) @db.Uuid
  orderId         String    @unique @map("order_id") @db.Uuid
  warehouseId     String?   @map("warehouse_id") @db.Uuid
  receivedBy      String?   @map("received_by")
  rtoDocketNumber String?   @map("rto_docket_number")
  rtoDate         DateTime?  @map("rto_date") @db.Date
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  warehouse       Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

  @@map("rto_records")
}

model InventoryItem {
  id                        String          @id @default(uuid()) @db.Uuid
  serialNumber              String          @unique @map("serial_number")
  model                     String
  partNo                    String?         @map("part_no")
  specs                     String?
  status                    InventoryStatus @default(AVAILABLE)
  partner                   String?
  sr                        Int?
  entity                    String?
  userBaseLocation          String?         @map("user_base_location")
  imageType                 String?         @map("image_type")
  purpose                   String?
  requestDate               DateTime?       @map("request_date") @db.Date
  count                     Int?
  employeeName              String?         @map("employee_name")
  emailId                   String?         @map("email_id")
  shippingAddress           String?         @map("shipping_address")
  landMark                  String?         @map("land_mark")
  city                      String?
  state                     String?
  pinCode                   String?         @map("pin_code")
  mobileNumber              String?         @map("mobile_number")
  pwcRemarks                String?         @map("pwc_remarks")
  laptopMake                String?         @map("laptop_make")
  laptopModel               String?         @map("laptop_model")
  invoiceProductDescription String?         @map("invoice_product_description")
  description               String?
  emailReceivedHour         String?         @map("email_received_hour")
  cutOffStatus              String?         @map("cut_off_status")
  slaStartDate              DateTime?       @map("sla_start_date") @db.Date
  slaState                  String?         @map("sla_state")
  zone                      String?
  tier                      String?
  odaLocation               String?         @map("oda_location")
  tat                       String?
  deliveryTatDays           Int?            @map("delivery_tat_days")
  actualDeliveryDate        DateTime?       @map("actual_delivery_date") @db.Date
  slaStatus                 String?         @map("sla_status")
  laptopAcceptanceDate      DateTime?       @map("laptop_acceptance_date") @db.Date
  invoicedQuantity          Int?            @map("invoiced_quantity")
  warrantyPeriod            String?         @map("warranty_period")
  warrantyEndPeriod         DateTime?       @map("warranty_end_period") @db.Date
  customerInstructionDoc    String?         @map("customer_instruction_doc")
  adaptorAdded              String?         @map("adaptor_added")
  accessoryHeadsetMouse     String?         @map("accessory_headset_mouse")
  stickerColour             String?         @map("sticker_colour")
  deliveryDate              DateTime?       @map("delivery_date") @db.Date
  dc                        String?
  vendor                    String?
  deliveredLocation         String?         @map("delivered_location")
  docketNumber              String?         @map("docket_number")
  trackingStatus            String?         @map("tracking_status")
  trackingSubStatus         String?         @map("tracking_sub_status")
  pickupDate                DateTime?       @map("pickup_date") @db.Date
  alternatePhoneNumber      String?         @map("alternate_phone_number")
  processStatus             String?         @map("process_status")
  machineWs1Status          String?         @map("machine_ws1_status")
  serialNoInWs1             String?         @map("serial_no_in_ws1")
  dateOfWs1Update           DateTime?       @map("date_of_ws1_update") @db.Date
  servicesStartDate         DateTime?       @map("services_start_date") @db.Date
  invoicingWarehouse        String?         @map("invoicing_warehouse")
  boxSerialNo               String?         @map("box_serial_no")
  checkField                String?         @map("check_field")
  remark                    String?         @map("remark")
  dcNumber                  String?         @map("dc_number")
  date                      DateTime?       @map("date") @db.Date
  csvStatus                 String?         @map("csv_status")

  // Provisioning asset tracking (from provisioning/asset import)
  engineerName          String?         @map("engineer_name")
  condition             String?         @map("condition")
  storageStatus         String?         @map("storage_status")
  rackNo                String?         @map("rack_no")
  devItInwardLotNo      String?         @map("dev_it_inward_lot_no")
  hpLotNumber           String?         @map("hp_lot_number")
  lotReceivedDate       DateTime?         @map("lot_received_date") @db.Date
  shippingDate          DateTime?         @map("shipping_date") @db.Date
  assetRemarks          String?           @map("asset_remarks")
  previousImageDate     DateTime?         @map("previous_image_date") @db.Date
  latestShippedDate     DateTime?         @map("latest_shipped_date") @db.Date
  latestCourierName     String?           @map("latest_courier_name")
  latestDocketNumber    String?           @map("latest_docket_number")
  latestTrackingStatus  String?           @map("latest_tracking_status")
  latestEwayBill        String?           @map("latest_eway_bill")
  latestDeliveryDate    DateTime?         @map("latest_delivery_date") @db.Date
  latestDc              String?           @map("latest_dc")
  inwardDate1           DateTime?         @map("inward_date_1") @db.Date
  outwardDate1          DateTime?         @map("outward_date_1") @db.Date
  inwardDate2           DateTime?         @map("inward_date_2") @db.Date
  outwardDate2          DateTime?         @map("outward_date_2") @db.Date
  inwardDate3           DateTime?         @map("inward_date_3") @db.Date
  outwardDate3          DateTime?         @map("outward_date_3") @db.Date
  inwardDate4           DateTime?         @map("inward_date_4") @db.Date
  outwardDate4          DateTime?         @map("outward_date_4") @db.Date
  inwardDate5           DateTime?         @map("inward_date_5") @db.Date
  outwardDate5          DateTime?         @map("outward_date_5") @db.Date
  inwardDate6           DateTime?         @map("inward_date_6") @db.Date
  outwardDate6          DateTime?         @map("outward_date_6") @db.Date

  // ── Assignment file fields (remote/office assignments) ──
  reqDateToDevIt        DateTime?         @map("req_date_to_dev_it") @db.Date
  deliveryTatDate       DateTime?         @map("delivery_tat_date") @db.Date
  expectedDeliveryDate  DateTime?         @map("expected_delivery_date") @db.Date
  ewayBill              String?           @map("eway_bill")
  docketDate            DateTime?         @map("docket_date") @db.Date
  fromWarehouseLocation String?           @map("from_warehouse_location")


  // ── QC before assignment (Clean & Purge) ──
  qcRequestedAt             DateTime?       @map("qc_requested_at")
  qcEngineer                String?         @map("qc_engineer")
  qcAssignedAt              DateTime?       @map("qc_assigned_at")
  qcLocation                String?         @map("qc_location")
  qcCleanResult             String?         @map("qc_clean_result")
  qcCleanRemarks            String?         @map("qc_clean_remarks")
  qcCleanDate               DateTime?       @map("qc_clean_date")
  qcCleanBy                 String?         @map("qc_clean_by")
  qcPurgeResult             String?         @map("qc_purge_result")
  qcPurgeRemarks            String?         @map("qc_purge_remarks")
  qcPurgeDate               DateTime?       @map("qc_purge_date")
  qcPurgeBy                 String?         @map("qc_purge_by")
  qcFinalResult             String?         @map("qc_final_result")
  qcRemarks                 String?         @map("qc_remarks")
  qcCompletedAt             DateTime?       @map("qc_completed_at")
  createdAt                 DateTime        @default(now()) @map("created_at")
  updatedAt                 DateTime        @updatedAt @map("updated_at")

  assets                   Asset[]
  assignmentRecords         AssignmentRecord[]
  reversePickupRequests     ReversePickupRequest[]

  @@index([status])
  @@index([invoicingWarehouse])
  @@map("inventory_items")
}

model AssignmentRecord {
  id                   String    @id @default(uuid()) @db.Uuid
  inventoryItemId      String    @map("inventory_item_id") @db.Uuid
  employeeName         String?   @map("employee_name")
  emailId              String?   @map("email_id")
  mobileNumber         String?   @map("mobile_number")
  alternatePhoneNumber String?   @map("alternate_phone_number")
  shippingAddress      String?   @map("shipping_address")
  landMark             String?   @map("land_mark")
  city                 String?
  state                String?
  pinCode              String?   @map("pin_code")
  purpose              String?
  requestDate          DateTime? @map("request_date") @db.Date
  userBaseLocation     String?   @map("user_base_location")
  imageType            String?   @map("image_type")
  count                Int?
  pwcRemarks           String?   @map("pwc_remarks")
  trackingStatus       String?   @map("tracking_status")
  trackingSubStatus    String?   @map("tracking_sub_status")
  dcNumber             String?   @map("dc_number")
  docketNumber         String?   @map("docket_number")
  deliveryDate         DateTime? @map("delivery_date") @db.Date
  assignedAt           DateTime  @default(now()) @map("assigned_at")

  inventoryItem        InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([inventoryItemId])
  @@map("assignment_records")
}

model DropdownOption {
  id        String   @id @default(uuid()) @db.Uuid
  category  String   // "entity" | "purpose" | "imageType"
  value     String
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([category, value])
  @@map("dropdown_options")
}

model Asset {
  id              String         @id @default(uuid()) @db.Uuid
  orderId         String         @map("order_id") @db.Uuid
  inventoryItemId String?        @map("inventory_item_id") @db.Uuid
  status          String         @default("pending") // pending, qc_pass, os_installed
  createdAt       DateTime       @default(now()) @map("created_at")

  order           Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)

  @@map("assets")
}

model DeliveryRecord {
  id                        String    @id @default(uuid()) @db.Uuid
  partner                   String?
  sr                        Int?
  entity                    String?
  userBaseLocation          String?   @map("user_base_location")
  imageType                 String?   @map("image_type")
  purpose                   String?
  requestDate               DateTime? @map("request_date") @db.Date
  serialNumber              String?   @map("serial_number")
  count                     Int?
  employeeName              String?   @map("employee_name")
  emailId                   String?   @map("email_id")
  shippingAddress           String?   @map("shipping_address")
  landMark                  String?   @map("land_mark")
  city                      String?
  state                     String?
  pinCode                   String?   @map("pin_code")
  mobileNumber              String?   @map("mobile_number")
  pwcRemarks                String?   @map("pwc_remarks")
  laptopMake                String?   @map("laptop_make")
  laptopModel               String?   @map("laptop_model")
  invoiceProductDescription String?   @map("invoice_product_description")
  description               String?
  emailReceivedHour         String?   @map("email_received_hour")
  cutOffStatus              String?   @map("cut_off_status")
  slaStartDate              DateTime? @map("sla_start_date") @db.Date
  slaState                  String?   @map("sla_state")
  zone                      String?
  tier                      String?
  odaLocation               String?   @map("oda_location")
  tat                       String?
  deliveryTatDays           Int?      @map("delivery_tat_days")
  actualDeliveryDate        DateTime? @map("actual_delivery_date") @db.Date
  slaStatus                 String?   @map("sla_status")
  laptopAcceptanceDate      DateTime? @map("laptop_acceptance_date") @db.Date
  invoicedQuantity          Int?      @map("invoiced_quantity")
  warrantyPeriod            String?   @map("warranty_period")
  warrantyEndPeriod         DateTime? @map("warranty_end_period") @db.Date
  customerInstructionDoc    String?   @map("customer_instruction_doc")
  adaptorAdded              String?   @map("adaptor_added")
  accessoryHeadsetMouse     String?   @map("accessory_headset_mouse")
  stickerColour             String?   @map("sticker_colour")
  deliveryDate              DateTime? @map("delivery_date") @db.Date
  dc                        String?
  vendor                    String?
  deliveredLocation         String?   @map("delivered_location")
  docketNumber              String?   @map("docket_number")
  trackingStatus            String?   @map("tracking_status")
  pickupDate                DateTime? @map("pickup_date") @db.Date
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")

  @@map("delivery_records")
}

model ReversePickupRequest {
  id                    String               @id @default(uuid()) @db.Uuid
  requestNumber         String               @unique

  // ── Request Info ──
  year                  Int?                 // Automatic
  type                  String?              // DD
  srNo                  String?              @map("sr_no")
  requestDateHp         DateTime?            @map("request_date_hp") @db.Date
  employeeId            String?              @map("employee_id")
  alternateId           String?              @map("alternate_id")
  lastWorkingDay        DateTime?            @map("last_working_day") @db.Date

  // ── User Details ──
  employeeName          String               @map("employee_name")
  emailId               String?              @map("email_id")
  mobileNumber          String?              @map("mobile_number")
  alternatePhoneNumber  String?              @map("alternate_phone_number")
  contact               String?              // Manual - additional contact

  // ── Asset Details ──
  serialNumber          String               @map("serial_number")
  model                 String               // Laptop Model (Automatic)
  entity                String?              // DD
  imageType             String?              @map("image_type") // DD
  accessories           String?              // Manual
  reason                String?              // DD

  // ── Pickup Location ──
  pickupAddress         String               @map("pickup_address")
  landmark              String?              @map("land_mark")
  city                  String?
  state                 String?
  pinCode               String?              @map("pin_code")

  // ── Warehouse / Logistics ──
  warehouseLocation     String?              @map("warehouse_location") // DD
  receiverSerialNo      String?              @map("receiver_serial_no")
  receiverSnEntity      String?              @map("receiver_sn_entity") // Automatic
  displayStatus         String?              @map("display_status") // DD
  eta                   DateTime?            @map("eta") @db.Date
  futureDatePickup      DateTime?            @map("future_date_pickup") @db.Date
  dependency            String?              // DD
  remarks               String?              // Manual (general remarks)

// ── SLA / TAT (mostly Automatic) ──
  emailReceivedHour     String?              @map("email_received_hour")
  cutOffStatus          String?              @map("cut_off_status") // Automatic
  slaStartDate          DateTime?            @map("sla_start_date") // Automatic
  slaState              String?              @map("sla_state") // Manual
  zone1                 String?              @map("zone_1") // Automatic
  tier1                 String?              @map("tier_1") // Automatic
  odaLocation           String?              @map("oda_location") // Automatic
  tat                   String?              // Automatic
  deliveryTat           String?              @map("delivery_tat") // Automatic
  expectedPickupDate    DateTime?            @map("expected_pickup_date") @db.Date // Automatic
  actualDeliveryPodDate DateTime?            @map("actual_delivery_pod_date") @db.Date
  sla                   String?              // Automatic
  laptopAcceptanceDate  DateTime?            @map("laptop_acceptance_date") // Automatic

  // ── Courier / Tracking ──
  courierName           String?              @map("courier_name") // DD
  docketNumber          String?              @map("docket_number")
  pickupDate            DateTime?            @map("pickup_date") @db.Date

  dcNo                  String?              @map("dc_no") // Automatic
  srnNo                 String?              @map("srn_no")
  eWayBillNo            String?              @map("e_way_bill_no") // Automatic
  eWayBillDocumentUrl   String?              @map("e_way_bill_document_url")
  etaForUnitReceived    DateTime?            @map("eta_for_unit_received") @db.Date
  caseAge               String?              @map("case_age") // Automatic

  // ── POD ──
  podDocumentUrl        String?              @map("pod_document_url")

  // ── Partner ──
  partnerName           String?              @map("partner_name")
  partnerReference      String?              @map("partner_reference")

  // ── Inspection ──
  inspectionRemarks     String?              @map("inspection_remarks")
  inspectionDate        DateTime?            @map("inspection_date") @db.Date

  // ── Warehouse Receipt ──
  receivedDate          DateTime?            @map("received_date") @db.Date
  receivedBy            String?              @map("received_by")

  // ── QC ──
  qcRemarks             String?              @map("qc_remarks")
  qcDate                DateTime?            @map("qc_date") @db.Date
  qcPerformedBy         String?              @map("qc_performed_by")
  qcResult              String?              @map("qc_result")

  // ── QC Level 1: Clean ──
  qcCleanResult         String?              @map("qc_clean_result")
  qcCleanRemarks        String?              @map("qc_clean_remarks")
  qcCleanDate           DateTime?            @map("qc_clean_date") @db.Date
  qcCleanBy             String?              @map("qc_clean_by")

  // ── QC Level 2: Purge ──
  qcPurgeResult         String?              @map("qc_purge_result")
  qcPurgeRemarks        String?              @map("qc_purge_remarks")
  qcPurgeDate           DateTime?            @map("qc_purge_date") @db.Date
  qcPurgeBy             String?              @map("qc_purge_by")

  // ── Blancco ──
  blanccoYesNo          String?              @map("blancco_yes_no") // DD
  blanccoDate           DateTime?            @map("blancco_date") @db.Date
  blancoCertificateUrl  String?              @map("blanco_certificate_url")
  blancoCertificateDate DateTime?            @map("blanco_certificate_date") @db.Date

  // ── Case Info ──
  caseId                String?              @map("case_id")
  issueReported         String?              @map("issue_reported")
  replacementPart       String?              @map("replacement_part")
  exceptionRemarks      String?              @map("exception_remarks")
  remark                String?

  // ── Provisioning ──
  provisioningStatus    String?              @map("provisioning_status") // DD: Yes/No

  // ── Disposition ──
  finalDisposition      String?              @map("final_disposition")

  // ── Workflow ──
  status                ReversePickupStatus   @default(REQUESTED)

  inventoryItemId       String?              @map("inventory_item_id") @db.Uuid
  inventoryItem         InventoryItem?       @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)

  createdBy             String?              @map("created_by")
  createdAt             DateTime             @default(now()) @map("created_at")
  updatedAt             DateTime             @updatedAt @map("updated_at")

  deliveryChallans      DeliveryChallan[]

  @@index([expectedPickupDate])
  @@index([sla])
  @@map("reverse_pickup_requests")
}

model VendorMaster {
  id            String   @id @default(uuid()) @db.Uuid
  grnNumber     String   @unique @map("grn_number")
  name          String
  email         String?
  phone         String?
  address       String?
  contactPerson String?  @map("contact_person")
  gstNumber     String?  @map("gst_number")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("vendor_master")
}

model ProductMaster {
  id          String   @id @default(uuid()) @db.Uuid
  make        String
  model       String
  partNo      String?  @map("part_no")
  description String?
  hsnCode     String?  @map("hsn_code")
  gstRate     Decimal? @map("gst_rate") @db.Decimal(5, 2)
  warranty    String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([make, model])
  @@map("product_master")
}

model Docket {
  id                   String   @id @default(uuid()) @db.Uuid
  orderId              String   @map("order_id") @db.Uuid
  docketNumber         String?  @map("docket_number")
  courierName          String?  @map("courier_name")
  ewayBillNumber       String?  @map("eway_bill_number")
  ewayBillDocumentUrl  String?  @map("eway_bill_document_url")
  podDocumentUrl       String?  @map("pod_document_url")
  createdAt            DateTime @default(now()) @map("created_at")

  order                Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("dockets")
}

model Warehouse {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  location  String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  deliveryChallans DeliveryChallan[]
  rtoRecords       RtoRecord[]

  @@map("warehouses")
}

model DeliveryChallan {
  id                      String                @id @default(uuid()) @db.Uuid
  orderId                 String?               @map("order_id") @db.Uuid
  reversePickupRequestId  String?               @map("reverse_pickup_request_id") @db.Uuid
  dcNumber                String                @unique @map("dc_number")
  dcDate                  DateTime              @map("dc_date") @db.Date
  warehouseId             String?               @map("warehouse_id") @db.Uuid
  shipToLocation          String?               @map("ship_to_location")
  billToLocation          String?               @map("bill_to_location")
  modeOfPayment           String?               @map("mode_of_payment")
  referenceNo             String?               @map("reference_no")
  referenceDate           DateTime?             @map("reference_date") @db.Date
  otherReferences         String?               @map("other_references")
  buyersOrderNo           String?               @map("buyers_order_no")
  buyersOrderDate         DateTime?             @map("buyers_order_date") @db.Date
  dispatchDocNo           String?               @map("dispatch_doc_no")
  dispatchedThrough       String?               @map("dispatched_through")
  destination             String?               @map("destination")
  termsOfDelivery         String?               @map("terms_of_delivery")
  amountInWords           String?               @map("amount_in_words")
  taxableValue            Decimal?              @map("taxable_value") @db.Decimal(12, 2)
  igst                    Decimal?              @map("igst") @db.Decimal(12, 2)
  totalTaxAmount          Decimal?              @map("total_tax_amount") @db.Decimal(12, 2)
  taxAmountInWords        String?               @map("tax_amount_in_words")
  createdAt               DateTime              @default(now()) @map("created_at")
  updatedAt               DateTime              @updatedAt @map("updated_at")

  order                   Order?                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reversePickupRequest    ReversePickupRequest? @relation(fields: [reversePickupRequestId], references: [id], onDelete: Cascade)
  warehouse               Warehouse?            @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  items                   DeliveryChallanItem[]

  @@map("delivery_challans")
}

model DeliveryChallanItem {
  id                String           @id @default(uuid()) @db.Uuid
  deliveryChallanId String           @map("delivery_challan_id") @db.Uuid
  description       String
  hsnSac            String?          @map("hsn_sac")
  quantity          Int
  rate              Decimal          @db.Decimal(12, 2)
  amount            Decimal          @db.Decimal(12, 2)
  taxableValue      Decimal?         @map("taxable_value") @db.Decimal(12, 2)
  igstRate          Decimal?         @map("igst_rate") @db.Decimal(5, 2)
  igstAmount        Decimal?         @map("igst_amount") @db.Decimal(12, 2)
  createdAt         DateTime         @default(now()) @map("created_at")

  deliveryChallan   DeliveryChallan  @relation(fields: [deliveryChallanId], references: [id], onDelete: Cascade)

  @@map("delivery_challan_items")
}

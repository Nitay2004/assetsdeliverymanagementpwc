# Production environment for DRServer-1 (172.16.20.27).
#
# Copy to /opt/asset-delivery-system/.env on DRServer-1 and fill in the blanks.
# docker compose reads this file automatically (it sits next to docker-compose.yml),
# and both deploy workflows read APP_PORT / DEPLOY_ENV out of it.
#
# DEPLOY_ENV=production is a safety interlock: the production workflow refuses to
# touch a host whose .env does not contain exactly this line.

DEPLOY_ENV=production
APP_PORT=3001

# ---------------------------------------------------------------- database
# Prisma migrator reads DIRECT_URL (see prisma.config.ts); the app runtime reads
# DATABASE_URL (see src/lib/prisma.ts). Keep both pointed at the same server.
DATABASE_URL=postgresql://assetdelivery:CHANGE_ME@172.16.20.28:5432/assetdelivery
DIRECT_URL=postgresql://assetdelivery:CHANGE_ME@172.16.20.28:5432/assetdelivery

# ---------------------------------------------------------------- 2FA
# 64 hex characters (32 bytes). Generate: openssl rand -hex 32
# Losing this key makes every existing TOTP secret undecryptable.
TWO_FACTOR_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS

# ---------------------------------------------------------------- PAFEX
PAFEX_API_COMPANY_ID=CHANGE_ME
PAFEX_CUSTOMER_CODE=CHANGE_ME
# Bearer token for POST /api/pafex/sync. Generate: openssl rand -base64 32
PAFEX_SYNC_API_KEY=CHANGE_ME

# ---------------------------------------------------------------- POD upload API
# Bearer token for POST /api/pods/upload. Generate: openssl rand -base64 32
POD_API_KEY=CHANGE_ME

# ---------------------------------------------------------------- document storage
# Documents (POD files etc.) are stored on the host filesystem, not in Supabase.
# Leave both Supabase vars blank to use the local filesystem provider.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Path inside the container. /app/uploads is where compose mounts the folder.
UPLOAD_DIR=/app/uploads
# Host folder that is bind-mounted onto /app/uploads. Must be writable by uid 1001
# (the `nextjs` user inside the image):
#   sudo mkdir -p /opt/asset-delivery-system/uploads
#   sudo chown -R 1001:1001 /opt/asset-delivery-system/uploads
UPLOAD_PATH=/opt/asset-delivery-system/uploads

# ---------------------------------------------------------------- session
# false because production is served over plain HTTP (no TLS terminator yet).
# Switch to true once the app is behind HTTPS, otherwise login breaks entirely.
SESSION_COOKIE_SECURE=false
